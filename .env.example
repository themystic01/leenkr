# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# Vite only exposes VITE_* to the browser; these two are the public ones.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# ---------------------------------------------------------------------------
# Server-side only. Put these in Vercel -> Settings -> Environment Variables
# (or .env.local when running `vercel dev`). Never prefix them with VITE_.
#
# Product files live in a PRIVATE Cloudflare R2 bucket. api/storage.js signs
# short-lived upload and download URLs after checking page ownership or a paid
# order, so the bucket itself is never public.
#
#   1. Cloudflare dashboard -> R2 -> Create bucket (e.g. leenkr-products).
#      Leave public access OFF.
#   2. R2 -> Manage R2 API Tokens -> Create token with Object Read & Write on
#      that bucket. It gives an Access Key ID and Secret Access Key.
#   3. The account id is the subdomain of the S3 endpoint:
#      <ACCOUNT_ID>.r2.cloudflarestorage.com
#   4. Supabase -> Project Settings -> API -> service_role key. Only the
#      function uses it, to verify ownership and paid orders.
#
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_xxx
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=leenkr-products
